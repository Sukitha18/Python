def count_moods(data):
    happy_count = 0
    sad_count = 0
    for sentence, mood in data:
        if mood == "Happy":
            happy_count += 1
        elif mood == "Sad":
            sad_count += 1
    return happy_count, sad_count
happy_words = [
    "happy", "excited", "great",
    "won", "tasty", "selected",
    "favourite", "love", "success", "wonderful"
]
sad_words = [
    "lost", "failed", "sad",
    "lonely", "upset", "cancelled",
    "missed", "cry", "disappointed", "problem"
]
def clean_sentence(sentence):
    sentence = sentence.lower()
    sentence = sentence.translate(
        str.maketrans("", "", string.punctuation)
    )
    return sentence.split()
def guess_mood(sentence):
    words = clean_sentence(sentence)
    happy_score = 0
    sad_score = 0
    for word in words:
        if word in happy_words:
            happy_score += 1
        if word in sad_words:
            sad_score += 1
    if happy_score > sad_score:
        return "Happy"
    elif sad_score > happy_score:
        return "Sad"
    else:
        return "Unknown"
print("       WELCOME TO MOOD GUESSER")
